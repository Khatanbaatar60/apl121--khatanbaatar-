<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="seminar 2-2 c"/>
        <attribute name="authors" value="user"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-20 04:38:40 PM"/>
        <attribute name="created" value="dXNlcjtERVNLVE9QLTc2TjJRQzc7MjAyNi0wOS0yMDswNDozNToyMCBQTTsyNzQ5"/>
        <attribute name="edited" value="dXNlcjtERVNLVE9QLTc2TjJRQzc7MjAyNi0wOS0yMDswNDozODo0MCBQTTsxOzI4NjI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i, factorial" type="Integer" array="False" size=""/>
            <input variable="n"/>
            <assign variable="factorial" expression="1"/>
            <assign variable="i" expression="1"/>
            <while expression="i &lt;= n">
                <assign variable="factorial" expression="factorial*i"/>
                <assign variable="i" expression="i+1"/>
            </while>
            <output expression="factorial" newline="True"/>
        </body>
    </function>
</flowgorithm>
